// La web de carmina.circulodeestudiosliterarios.com, en Cloudflare Workers
// (9-oct-2026; antes, GitHub Pages). La sube etl/subir_legales.py a la raíz
// del repositorio carmina-datos, y Cloudflare la despliega en cada envío.
//
// Los archivos (legal/, a/) se sirven tal cual; lo demás llega a worker.js,
// que hace las páginas /t/ de las traducciones compartidas (Fase 2).
{
  // Tiene que llamarse como el Worker en Cloudflare (Workers & Pages).
  "name": "carmina-datos",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // La raíz del repositorio; .assetsignore deja fuera lo que no es web.
  // `html_handling: none`: cada archivo en su dirección exacta, con su
  // `.html`. Por defecto Cloudflare redirige `/legal/privacidad.html` a
  // `/legal/privacidad`, y ésas son las direcciones de las tiendas y de la
  // app. Las carpetas (`/a/`) las resuelve worker.js.
  "assets": { "directory": ".", "binding": "ASSETS", "html_handling": "none" },
  "vars": {
    // El Píxel de Meta de la web (David, 9-oct-2026). Con él, la portada, /t/,
    // /a/, /palabras y /p/ llevan el aviso de cookies, y el Píxel se carga
    // sólo tras «Aceptar» (worker.js, «El aviso de cookies y el Píxel de
    // Meta»). Quitarlo apaga las dos cosas. Es público: va escrito en la página.
    "PIXEL_ID": "1360946059199413",
    // El id de Carmina en la App Store (App Store Connect › Información de la
    // app › Apple ID), para el anuncio de Safari.
    "APP_STORE_ID": "6808968860",
    // Las tiendas (20-nov-2026: la 1.0.1 está en las dos). Con ellas la
    // portada, /t/, /a/ y /p/ dejan de decir «Muy pronto» y llevan a la
    // tienda; worker.js les añade la campaña (`?ct=` a la de Apple,
    // `&utm_campaign=` a la de Google, que por eso ya lleva su `?id=`).
    "APP_STORE": "https://apps.apple.com/app/id6808968860",
    // El «provider token» de la cuenta de Apple (23-nov-2026): sin él, App
    // Analytics NO cuenta las campañas (`ct=`) de la web. Es un número, el
    // mismo para todas las campañas, y público (va en cada enlace). Sólo lo da
    // App Store Connect: Apps › Carmina › Analytics › Adquisición › Campañas ›
    // +, con cualquier nombre; el enlace que sale lleva `pt=<número>`, y ese
    // número va aquí. Vacío, los enlaces siguen con `ct=` solo, como hasta hoy.
    "APP_STORE_PT": "",
    "GOOGLE_PLAY": "https://play.google.com/store/apps/details?id=com.circuloestudiosliterarios.carmina_app",
    "SUPABASE_URL": "https://rpzrcrsjphrrzqpzjaec.supabase.co",
    // La clave PÚBLICA (rol «anon»), la misma que lleva la app: sólo puede
    // lo que permiten las funciones públicas (leer_pagina_publica y
    // denunciar_pagina). Nunca la de servicio.
    "SUPABASE_ANON": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJwenJjcnNqcGhycnpxcHpqYWVjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczNzcxNTEsImV4cCI6MjEwMjk1MzE1MX0.4VvVh0Ej4X23ZvjbDj0GXGUuYU2CIJPCVoHyvPVR4us"
  }
}
